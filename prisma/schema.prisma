// Калькулятор калорій — Prisma schema
// Дані ізольовані в Postgres-схемі "calories" на спільній Neon-базі,
// щоб не зачіпати таблиці іншого проєкту (див. CALORIES_DATABASE_URL у .env).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("CALORIES_DATABASE_URL")
  directUrl = env("CALORIES_DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  name           String
  targetCalories Int // денна норма (обчислюється з формули, зберігається)
  birthYear      Int       @default(1995)
  birthMonth     Int       @default(1) // 1–12
  sex            String    @default("male") // male | female
  activityLevel  String    @default("moderate") // sedentary…very_active
  goal           String    @default("maintain") // maintain | deficit
  weight         Float     @default(70)
  height         Float     @default(175)
  avatarUrl      String? // data:image/png;base64,… (мультяшний аватар від Gemini)
  createdAt      DateTime  @default(now())
  meals          MealLog[]
}

model MealLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String // YYYY-MM-DD
  description String
  calories    Int
  protein     Int
  fats        Int
  carbs       Int
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([userId, date])
}
