// AI Home Trainer — Prisma schema
//
// Дані ізольовані в Postgres-схемі "trainer" на спільній Neon-базі
// (поряд із "calories", "public", "neon_auth" — їх не чіпаємо).
// Схема задається через ?schema=trainer у TRAINER_DATABASE_URL / TRAINER_DIRECT_URL.
//
// ⚠️ Ніколи: `prisma migrate reset`, `prisma db push --force-reset`, `prisma migrate dev`
// (shadow-БД на спільній хостованій базі). Лише `prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("TRAINER_DATABASE_URL")
  directUrl = env("TRAINER_DIRECT_URL")
}

/// Профіль атлета. Застосунок одноюзерний: рівно один рядок з id = "me".
model UserProfile {
  id          String   @id @default("me")
  name        String   @default("Атлет")
  sex         String   @default("male")
  age         Int      @default(35)
  heightCm    Int      @default(186)
  weightKg    Float    @default(93.5)
  /// Ціль словами — іде в промпт генератора як є.
  goal        String   @default("Зниження ваги / сушка, збереження і ріст силової витривалості")
  /// Обмеження/здоров'я — теж іде в промпт (спина, суглоби, травми).
  limitations String   @default("Берегти спину та суглоби: без ривків, без осьового перевантаження, контроль техніки")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_profile")
}

/// Домашній інвентар (з фото через Gemini Vision або вручну).
model Equipment {
  id          String   @id @default(cuid())
  name        String
  /// Нормалізований ключ (lowercase, без зайвих пробілів) — дедуплікація при повторних скан-ах.
  key         String   @unique
  detail      String?
  /// strength | cardio | mobility | other
  category    String   @default("strength")
  /// Чи регульована вага (розбірна гантеля, гиря зі змінними блінами).
  adjustable  Boolean  @default(false)
  maxWeightKg Float?
  /// Поточна зібрана/доступна вага для регульованих предметів.
  weightKg    Float?
  /// Вимкнений предмет не потрапляє в генерацію плану.
  active      Boolean  @default(true)
  /// manual | vision
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("equipment")
}

/// Тижневий план. На один weekStart — максимум один plan зі status = "active":
/// це гарантує частковий унікальний індекс workout_plans_one_active_per_week (міграція SQL; Prisma такі індекси не описує).
model WorkoutPlan {
  id        String       @id @default(cuid())
  /// Понеділок тижня, "YYYY-MM-DD" (рахується на клієнті в локальному часі).
  weekStart String
  /// active | archived (перегенерований тиждень архівується, не видаляється).
  status    String       @default("active")
  /// Коротке пояснення від тренера: логіка навантаження на тиждень.
  summary   String?
  /// Яка модель згенерувала план (для налагодження).
  model     String?
  createdAt DateTime     @default(now())
  days      WorkoutDay[]

  @@index([weekStart, status])
  @@map("workout_plans")
}

model WorkoutDay {
  id          String       @id @default(cuid())
  planId      String
  plan        WorkoutPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// 0 = Пн … 4 = Пт
  weekday     Int
  /// "YYYY-MM-DD" (weekStart + weekday)
  date        String
  /// strength | cardio | mobility | mixed
  type        String
  /// Фокус дня: «Верх тіла + Прес»
  focus       String
  title       String?
  durationMin Int
  caloriesEst Int
  /// Очікуване RPE 1–10
  rpe         Float?
  /// Якщо день адаптовано під стан: fatigued | short_time | full_power
  adaptedMode String?
  exercises   Exercise[]
  logs        WorkoutLog[]

  @@unique([planId, weekday])
  @@map("workout_days")
}

/// Рядок плану дня: розминка / основний блок / заминка.
model Exercise {
  id          String       @id @default(cuid())
  dayId       String
  day         WorkoutDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  /// warmup | main | cooldown
  block       String       @default("main")
  position    Int
  name        String
  /// strength | cardio | mobility
  type        String       @default("strength")
  /// Вільний підпис обладнання: «Турнік», «Гантеля», «Власна вага»
  equipment   String?
  sets        Int?
  /// "8–10", "15 / рука", "40с спринт / 80с темп"
  reps        String?
  durationSec Int?
  /// Темп повтору: «2-0-1» або словами
  tempo       String?
  /// Вага/опір: «13 кг», «опір 5–6 з 8», «власна вага»
  load        String?
  restSec     Int          @default(60)
  /// «Як робити»: прості кроки для новачка (стартова поза → рух → на що звернути увагу)
  tip         String       @default("")
  /// Пошуковий запит для відео-демонстрації на YouTube (англійською — результатів більше й вони краще)
  videoQuery  String?
  logs        WorkoutLog[]

  @@index([dayId, block, position])
  @@map("exercises")
}

/// Журнал виконання. Один рядок на (день, ціль): ціль = id вправи або "workout"
/// (завершення всього тренування). Унікальність → hold-to-complete ідемпотентний.
model WorkoutLog {
  id          String      @id @default(cuid())
  dayId       String
  day         WorkoutDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  /// null для логу всього тренування
  exerciseId  String?
  exercise    Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  /// exercise | workout
  kind        String
  /// exerciseId або "workout"
  target      String
  completedAt DateTime    @default(now())

  @@unique([dayId, target])
  @@index([completedAt])
  @@map("workout_logs")
}

/// Кеш пошуку відео. Один запит до YouTube Data API коштує 100 одиниць квоти (ліміт ~10 000/добу), тож результат
/// запам'ятовується на ВАРІАНТ ЗАПИТУ, а не на вправу: «plank exercise form» шукається один раз для всіх планів.
/// Політика YouTube API дозволяє зберігати такі дані не довше 30 днів — старіші рядки оновлюються або видаляються.
model VideoCache {
  /// Нормалізований запит (нижній регістр, без зайвих пробілів)
  key        String   @id
  /// [{ id, title, channel }] — до 5 кандидатів; «Інше відео» гортає їх без нових запитів до API
  candidates Json
  createdAt  DateTime @default(now())

  @@map("video_cache")
}

/// Невдалі (і всі) спроби входу за IP — захист від підбору пароля, що переживає холодні старти serverless.
/// Спроба записується ДО перевірки пароля й видаляється після успіху, тож паралельні запити теж рахуються.
model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("login_attempts")
}
