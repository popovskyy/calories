// Калькулятор калорій — Prisma schema
// Дані ізольовані в Postgres-схемі "calories" на спільній Neon-базі.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("CALORIES_DATABASE_URL")
  directUrl = env("CALORIES_DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String
  name            String
  targetCalories  Int
  birthYear       Int      @default(1995)
  birthMonth      Int      @default(1)
  sex             String   @default("male")
  activityLevel   String   @default("moderate")
  goal            String   @default("maintain")
  weight          Float    @default(70)
  height          Float    @default(175)
  avatarUrl       String?
  theme           String   @default("nocturne")
  targetWeight    Float?
  startWeight     Float?
  startWeightDate String?
  approved        Boolean  @default(true)
  blockedAt       DateTime?
  blockReason     String?
  createdAt       DateTime @default(now())
  meals           MealLog[]
  activities      ActivityLog[]
  weights         WeightLog[]
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  weight    Float
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model MealLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String
  description String
  calories    Int
  protein     Int
  fats        Int
  carbs       Int
  imageUrl    String?
  status      String   @default("approved")
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([status, createdAt])
}

model ActivityLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String
  description    String
  caloriesBurned Int
  durationMin    Int?
  status         String   @default("approved")
  createdAt      DateTime @default(now())

  @@index([userId, date])
  @@index([status, createdAt])
}
